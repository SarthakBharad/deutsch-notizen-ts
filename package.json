{
    "name":  "deutsch-notizen-web",
    "version":  "1.0.0",
    "private":  true,
    "description":  "A reader for my German notes, built from the LibreOffice files themselves.",
    "packageManager":  "pnpm@10.0.0",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "notes":  "tsx scripts/build-notes.ts",
                    "predev":  "pnpm notes",
                    "dev":  "next dev",
                    "prebuild":  "pnpm notes",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint .",
                    "typecheck":  "tsc --noEmit"
                },
    "dependencies":  {
                         "next":  "15.5.7",
                         "react":  "19.1.2",
                         "react-dom":  "19.1.2"
                     },
    "devDependencies":  {
                            "@eslint/eslintrc":  "3.2.0",
                            "@types/node":  "22.10.5",
                            "@types/react":  "19.1.8",
                            "@types/react-dom":  "19.1.6",
                            "eslint":  "9.18.0",
                            "eslint-config-next":  "15.5.7",
                            "fflate":  "0.8.2",
                            "tsx":  "4.19.2",
                            "typescript":  "5.7.3"
                        }
}
